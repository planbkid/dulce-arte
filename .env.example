# Copia este archivo como .env y completa los valores reales.
# (El .env NO se sube a Git.)

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
# Si dejas DB_NAME vacío, el proyecto usa SQLite automáticamente.
DB_NAME=dulcearte_db
DB_USER=dulce_user
DB_PASSWORD=TuClaveSegura123
DB_HOST=localhost
DB_PORT=5432

# En AWS (producción) agrega la IP pública, p.ej:
# ALLOWED_HOSTS=127.0.0.1,localhost,<IP_PUBLICA_EC2>
# CSRF_TRUSTED_ORIGINS=http://<IP_PUBLICA_EC2>

# Activa cookies seguras/HTTPS SOLO si la instancia tiene certificado TLS.
# Déjalo en False para el despliegue HTTP de AWS Academy.
USAR_HTTPS=False
